{
  "name": "@gad-lang/git-vuetify-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Demo of @gad-lang/git-vuetify: the Git and Changes panels driven by the example TypeScript backend (../server) on a local repository.",
  "scripts": {
    "server": "bun run ../server/main.ts",
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gad-lang/codemirror-gad": "^0.1.0-rc.1",
    "@gad-lang/git-vuetify": "file:..",
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "@mdi/font": "^7.4.47",
    "dockview-core": "^7.0.4",
    "dockview-vue": "^7.0.4",
    "vue": "^3.4.0",
    "vue-i18n": "^11.1.11",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
